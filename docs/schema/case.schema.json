{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apicase.dev/schema/case.schema.json",
  "title": "apicase 用例配置",
  "description": "单个 API 测试用例。由 AI 生成或人工编写，apicase validate 可校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "name": {
      "type": "string",
      "description": "用例名（缺省用文件名去扩展名）"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "标签，run --tag 过滤；与所在集合 collection.json 的 tags 合并"
    },
    "skip": {
      "type": "boolean",
      "default": false,
      "description": "跳过该用例"
    },
    "request": { "$ref": "#/definitions/request" },
    "pre": {
      "type": "string",
      "description": "前置 JS 脚本：请求发出前执行。可改写 req.method/url/headers/body，辅助 req.setJson(obj)。可读 vars/env，写 vars.* 传递变量。可用 crypto.md5/sha256/hmacSha256/base64Encode/base64Decode 与 log()"
    },
    "post": {
      "type": "string",
      "description": "后置 JS 脚本：响应返回后、断言前执行。读 res.status/headers/timeMs/json()/text()，写 vars.* 捕获传递给后续用例"
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "断言：JS 表达式数组，逐条求值，真值为通过。可见 res/vars/env/crypto"
    }
  },
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
          "description": "HTTP 方法（大写）"
        },
        "url": {
          "type": "string",
          "description": "请求 URL，支持 {{var}} 替换，仅 http/https"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "请求头，值支持 {{var}}"
        },
        "body": {
          "description": "请求体：{\"json\": <对象/数组>} 序列化为 JSON 并自动 Content-Type；{\"text\": \"字符串\"} 原样发送。JSON 内 {{var}} 在引号内按字符串替换，需数值时写在引号外",
          "oneOf": [
            {
              "type": "object",
              "required": ["json"],
              "additionalProperties": false,
              "properties": { "json": true }
            },
            {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": { "text": { "type": "string" } }
            }
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "description": "单请求超时毫秒，缺省用 apicase.json 的 timeoutMs"
        },
        "retry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "传输层重试次数（curl --retry）"
        },
        "insecure": {
          "type": "boolean",
          "default": false,
          "description": "跳过 TLS 证书校验（curl -k）"
        },
        "followRedirects": {
          "type": "boolean",
          "default": false,
          "description": "跟随 3xx 重定向（curl -L）"
        }
      }
    }
  }
}
