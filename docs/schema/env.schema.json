{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://requestbaby.dev/schema/env.schema.json",
  "title": "requestbaby 环境配置",
  "description": "envs/<name>.json：环境变量层（优先级高于项目全局变量，低于集合与运行时变量）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vars"
  ],
  "properties": {
    "vars": {
      "type": "object",
      "description": "变量表：标量直接字符串化；对象形态支持 secret 脱敏与外部来源",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "secret": {
                "type": "boolean",
                "description": "所有输出层自动脱敏为 ****"
              },
              "from": {
                "type": "string",
                "enum": [
                  "env"
                ]
              },
              "name": {
                "type": "string",
                "description": "from:env 时的环境变量名（缺省用变量名）"
              }
            }
          }
        ]
      }
    }
  }
}
