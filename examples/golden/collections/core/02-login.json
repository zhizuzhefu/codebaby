{
  "name": "登录并捕获token",
  "expectStatus": 200,
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/auth/login",
    "body": {
      "json": {
        "username": "{{username}}",
        "password": "{{password}}"
      }
    }
  },
  "post": "vars.token = res.json('token'); log('token captured: ' + vars.token)",
  "tests": [
    "data.token !== undefined",
    "data.expires_in === 3600"
  ]
}
