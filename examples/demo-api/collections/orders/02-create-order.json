{
  "name": "create-order",
  "tags": ["smoke", "order"],
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/post",
    "headers": { "Authorization": "Bearer {{echoUser}}" },
    "body": { "json": { "sku": "{{sku}}", "qty": "{{qty}}" } }
  },
  "pre": "req.setJson({ sku: env.sku, qty: Number(env.qty), sign: crypto.md5(env.sku + ':' + env.qty) })",
  "tests": [
    "res.status === 200",
    "res.json().json.qty === 2",
    "res.json().json.sign.length === 32",
    "res.json().headers.Authorization === 'Bearer admin'"
  ]
}
